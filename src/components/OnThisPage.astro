---
// "On this page": a sticky contents list beside long lessons on wide screens,
// and a small "Jump to" button on phones. Built in the browser from the lesson's own sections.
---
<nav class="otp" aria-label="On this page" hidden>
  <div class="otp-inner">
    <p class="otp-title small">On this page</p>
    <ol class="otp-list"></ol>
  </div>
</nav>
<button type="button" class="otp-fab" aria-haspopup="dialog" hidden>Jump to <span aria-hidden="true">↕</span></button>
<dialog class="otp-sheet" aria-label="Jump to a section">
  <div class="otp-sheet-head"><p class="otp-title small">Jump to</p><button type="button" class="otp-close">Close</button></div>
  <ol class="otp-list"></ol>
</dialog>

<style is:global>
  .lesson-layout { position: relative; }
  .otp { display: none; }
  @media (min-width: 1180px) {
    .otp:not([hidden]) { display: block; position: absolute; top: 0; bottom: 0; right: 20px; width: 220px; }
  }
  .otp-inner { position: sticky; top: 96px; max-height: calc(100vh - 120px); overflow: auto; }
  .otp-title { font-weight: 800; text-transform: uppercase; letter-spacing: .06em; font-size: .72rem; color: var(--ink-2); margin: 0 0 8px; }
  .otp-list { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--rule); }
  .otp-list a { display: block; padding: 6px 0 6px 12px; margin-left: -2px; border-left: 2px solid transparent; color: var(--ink-2); text-decoration: none; font-size: .92rem; line-height: 1.3; }
  .otp-list a:hover { color: var(--ink); }
  .otp-list a[aria-current='true'] { color: var(--ink); font-weight: 750; border-left-color: var(--marker); }
  .otp-list li[hidden] { display: none; }
  .otp-fab { position: fixed; right: 14px; bottom: 16px; z-index: 30; font: inherit; font-weight: 800; font-size: .9rem; padding: 10px 16px; border-radius: 999px; border: 2px solid var(--marker-ink); background: var(--marker); color: var(--marker-ink); box-shadow: 0 4px 14px rgba(9,16,30,.25); cursor: pointer; transition: opacity .2s, transform .2s; }
  .otp-fab.away { opacity: 0; transform: translateY(12px); pointer-events: none; }
  @media (min-width: 1180px) { .otp-fab { display: none; } }
  .otp-sheet { margin: auto auto 0; width: 100%; max-width: 520px; border: 2px solid var(--ink); border-bottom: 0; border-radius: 18px 18px 0 0; padding: 14px 18px 22px; background: var(--surface); color: var(--ink); }
  .otp-sheet::backdrop { background: rgba(9,16,30,.5); }
  .otp-sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .otp-close { font: inherit; font-weight: 700; background: none; border: 0; color: var(--link); cursor: pointer; }
  .otp-sheet .otp-list a { font-size: 1.05rem; padding: 10px 0 10px 14px; }
  @media (prefers-reduced-motion: reduce) { .otp-fab { transition: none; } }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.otp');
  const fab = document.querySelector<HTMLButtonElement>('.otp-fab');
  const sheet = document.querySelector<HTMLDialogElement>('.otp-sheet');
  const article = document.querySelector<HTMLElement>('article');
  if (nav && fab && sheet && article) {
    const slug = (t: string) => t.toLowerCase().replace(/[’']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    type Item = { el: HTMLElement; label: string };
    const items: Item[] = [];
    const add = (el: HTMLElement | null, label?: string | null) => {
      if (!el || !label) return;
      if (!el.id) el.id = slug(label);
      items.push({ el, label: label.trim() });
    };
    const prose = article.querySelector('.prose');
    for (const el of Array.from(prose?.children ?? []) as HTMLElement[]) {
      if (el.classList.contains('layer')) add(el, el.querySelector('.layer-name')?.textContent);
      else if (el.tagName === 'H2') add(el, el.textContent);
      else if (el.classList.contains('game')) add(el, el.querySelector('h3')?.textContent);
    }
    add(article.querySelector<HTMLElement>('.buyer-score'), 'Buyer score');
    add(article.querySelector<HTMLElement>('.quiz'), 'Check yourself');
    add(article.querySelector<HTMLElement>('.flash'), 'Revision cards');

    if (items.length >= 4) {
      const lists = Array.from(document.querySelectorAll<HTMLOListElement>('.otp-list'));
      lists.forEach((ol) => {
        ol.innerHTML = items.map((it) => `<li><a href="#${it.el.id}">${it.label.replace(/</g, '&lt;')}</a></li>`).join('');
      });
      nav.hidden = false;
      fab.hidden = false;
      const links = () => lists.map((ol) => Array.from(ol.querySelectorAll('a')));

      // Highlight the section being read
      let current = '';
      const setCurrent = (id: string) => {
        if (id === current) return;
        current = id;
        links().flat().forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${id}`)));
      };
      // The current section is the last one whose top has passed a line 30% down the screen
      let ticking = false;
      const track = () => {
        ticking = false;
        const line = innerHeight * 0.3;
        let id = items[0].el.id;
        for (const it of items) { if (!it.el.hidden && it.el.getBoundingClientRect().top <= line) id = it.el.id; }
        setCurrent(id);
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(track); } }, { passive: true });
      track();

      // Follow the reading mode: hide entries for sections that are hidden
      const syncHidden = () => links().forEach((ls) => ls.forEach((a, i) => { (a.parentElement as HTMLElement).hidden = items[i].el.hidden; }));
      new MutationObserver(syncHidden).observe(article, { attributes: true, attributeFilter: ['hidden'], subtree: true });

      // Phones: floating button opens a sheet; hidden near the top and bottom of the page
      fab.addEventListener('click', () => sheet.showModal());
      sheet.querySelector('.otp-close')!.addEventListener('click', () => sheet.close());
      sheet.addEventListener('click', (e) => { if (e.target === sheet || (e.target as Element).closest('a')) sheet.close(); });
      const onScroll = () => {
        const y = window.scrollY, end = document.documentElement.scrollHeight - innerHeight - 200;
        fab.classList.toggle('away', y < 500 || y > end);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
