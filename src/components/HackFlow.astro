---
// Step-by-step "how the attack worked" diagram for the Optimizely news post.
// Built in HTML/CSS (no images), styled like a glowing blueprint. Tap a box or press play.
const caps = [
  { title: 'Press play, or tap any box', text: 'Blue boxes are trusted tools working normally. Orange is the attacker. Watch how one break-in reaches visitors of 178 websites.' },
  { title: 'The break-in', text: 'The attacker uses a flaw that Optimizely says was in its account sign-up process. It gives them the power to edit other companies’ projects.' },
  { title: 'The poisoned setting', text: 'They paste a few lines of code into the “Project JavaScript” box of 178 companies’ projects. Whatever sits in that box runs on every page of those companies’ websites.' },
  { title: 'Delivered as normal', text: 'Optimizely’s own servers send the updated script out, exactly as they would for a normal design test. Nothing about the delivery looks unusual.' },
  { title: 'The trusted website', text: 'BBC, CNN, Zoom, HSBC and the rest already have one line on their pages telling browsers: also load Optimizely’s script. They changed nothing.' },
  { title: 'Your browser', text: 'Your browser runs the script with the same powers as the website’s own code. It quietly downloads the attacker’s main program and starts watching what you copy and what you type at checkout.' },
  { title: 'The getaway', text: 'Card numbers, expiry dates and security codes, plus screenshots and swapped crypto wallet addresses, are sent to the attacker’s server. The page still works, so nobody notices.' },
];
const nodes = [
  { c: 'orange', t: 'Attacker', s: 'Finds a weak spot in Optimizely', ic: '<path d="M12 3a6 6 0 0 0-6 6v3l-2 8h16l-2-8V9a6 6 0 0 0-6-6z"/><path d="M9 11.5h1.5M13.5 11.5H15"/>' },
  { c: 'blue', t: 'Optimizely control panel', s: 'Where 178 companies set up their design tests', ic: '<rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8.5h18M7 12.5h4M7 15.5h8"/><circle cx="16.5" cy="12.5" r="1.3"/>' },
  { c: 'blue', t: 'Optimizely’s servers', s: 'Send each company’s script to visitors', ic: '<path d="M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9.5a4.25 4.25 0 0 1-.5 8.5z"/>' },
  { c: 'blue', t: 'Big-name websites', s: 'BBC · CNN · Zoom · HSBC + 174 more', ic: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>' },
  { c: 'blue', t: 'Your browser', s: 'Runs every script the page asks for', ic: '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/><rect x="8" y="8.3" width="8" height="4.6" rx="1"/><path d="M8 10.2h8"/>' },
  { c: 'orange', t: 'Attacker’s server', s: 'Collects cards, cookies and screenshots', ic: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 7h7M8.5 10h7M12 13v5M9.8 16l2.2 2.2 2.2-2.2"/>' },
];
const arrows = [
  { c: 'orange', d: 'r', l: 'exploits a flaw' },
  { c: 'orange', d: 'r', l: 'edits 178 projects' },
  { c: 'blue', d: 'd', l: 'serves the script' },
  { c: 'blue', d: 'l', l: 'page loads it' },
  { c: 'orange', d: 'l', l: 'sends stolen data' },
];
---
<section class="hf" id="hf-optimjack" hidden aria-labelledby="hf-title">
  <p class="hf-tag">How the attack worked</p>
  <h3 id="hf-title">One flaw, 178 websites, about 16 hours</h3>
  <div class="hf-grid">
    {nodes.map((n, i) => (
      <button type="button" class={`hf-node ${n.c}`} style={`grid-area: n${i + 1}`} data-i={i + 1} aria-pressed="false">
        <span class="hf-num">{i + 1}</span>
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.ic} />
        <span class="t">{n.t}</span>
        <span class="s">{n.s}</span>
      </button>
    ))}
    {arrows.map((a, i) => (
      <div class={`hf-arrow ${a.c} ${a.d}`} style={`grid-area: a${i + 1}`} aria-hidden="true">
        <span class="lab"><b>{i + 1}</b> {a.l}</span>
        <span class="ln"></span>
      </div>
    ))}
  </div>
  <div class="hf-cap" aria-live="polite">
    <p class="k">How to use this</p>
    <p class="ct">{caps[0].title}</p>
    <p class="cx">{caps[0].text}</p>
  </div>
  <div class="hf-ctl">
    <button type="button" class="hf-play">▶ Play the attack</button>
    <button type="button" class="hf-step" data-d="-1" aria-label="Previous step" disabled>←</button>
    <button type="button" class="hf-step" data-d="1" aria-label="Next step">→</button>
  </div>
  <script type="application/json" class="hf-data" set:html={JSON.stringify(caps)} />
</section>

<style is:global>
  .prose .hf, .hf { width: min(1080px, calc(100vw - 40px)); max-width: none; margin: 1.5rem 0 2.25rem; padding: 26px 24px 22px; border-radius: 20px; color: #e6eef9;
    background:
      linear-gradient(rgba(56,189,248,.07) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgba(56,189,248,.07) 1px, transparent 1px) 0 0 / 28px 28px,
      radial-gradient(ellipse at 50% 0%, #15305e 0%, #0a1630 70%);
    box-shadow: 0 10px 30px -12px rgba(9,16,30,.6); border: 1px solid #1f3a66; }
  .hf p { color: inherit; }
  .hf-tag { display: inline-block; margin: 0 0 6px; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #0a1630; background: #fb923c; padding: 3px 10px; border-radius: 999px; }
  .prose .hf h3, .hf h3 { margin: 0 0 18px; color: #fff; font-size: 1.45rem; }
  .hf-grid { display: grid; grid-template-columns: minmax(0,1fr) 128px minmax(0,1fr) 128px minmax(0,1fr);
    grid-template-areas: "n1 a1 n2 a2 n3" ". . . . a3" "n6 a5 n5 a4 n4"; }
  .hf .blue { --c: #38bdf8; }
  .hf .orange { --c: #fb923c; }
  .hf-node { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; text-align: left; font: inherit; cursor: pointer;
    color: #e6eef9; background: rgba(10, 24, 50, .88); border: 2px solid var(--c); border-radius: 14px; padding: 14px 14px 16px;
    box-shadow: 0 0 18px -6px var(--c), inset 0 0 22px -14px var(--c); transition: opacity .3s, transform .3s, box-shadow .3s; }
  .hf-node:hover { box-shadow: 0 0 26px -4px var(--c), inset 0 0 22px -12px var(--c); }
  .hf-num { position: absolute; top: 10px; right: 12px; font-weight: 800; font-size: .8rem; color: var(--c); }
  .hf-node .ic { width: 38px; height: 38px; color: var(--c); filter: drop-shadow(0 0 6px var(--c)); }
  .hf-node .t { font-weight: 800; font-size: 1.02rem; line-height: 1.25; }
  .hf-node .s { font-size: .85rem; color: #a9bbd6; line-height: 1.35; }
  .hf-arrow { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 0 8px; color: var(--c); }
  .hf-arrow .lab { font-size: .74rem; font-weight: 700; line-height: 1.25; text-align: center; color: #dbe7f7; }
  .hf-arrow .lab b { color: var(--c); }
  .hf-arrow .ln { position: relative; display: block; background: currentColor; border-radius: 2px; box-shadow: 0 0 8px currentColor; width: 100%; height: 3px; }
  .hf-arrow .ln::after { content: ''; position: absolute; border: 8px solid transparent; }
  .hf-arrow.r .ln::after { right: -12px; top: 50%; transform: translateY(-50%); border-left: 12px solid currentColor; border-right: 0; }
  .hf-arrow.l .ln::after { left: -12px; top: 50%; transform: translateY(-50%); border-right: 12px solid currentColor; border-left: 0; }
  .hf-arrow.l { flex-direction: column-reverse; }
  .hf-arrow.l .lab { order: 0; }
  .hf-arrow.d { flex-direction: row; padding: 10px 0 14px; }
  .hf-arrow.d .ln { width: 3px; height: 46px; order: 0; }
  .hf-arrow.d .lab { order: 1; text-align: left; max-width: 60%; }
  .hf-arrow.d .ln::after { bottom: -12px; left: 50%; transform: translateX(-50%); border-top: 12px solid currentColor; border-bottom: 0; }
  /* Playing: future steps fade, the current step glows */
  .hf.on .hf-node:not(.done):not(.active), .hf.on .hf-arrow:not(.done) { opacity: .26; }
  .hf-node.active { transform: scale(1.035); box-shadow: 0 0 34px -2px var(--c), inset 0 0 26px -10px var(--c); animation: hf-pulse 1.6s ease-in-out infinite; }
  @keyframes hf-pulse { 50% { box-shadow: 0 0 46px 2px var(--c), inset 0 0 30px -8px var(--c); } }
  .hf-cap { margin-top: 20px; border: 1px solid rgba(255,255,255,.14); border-radius: 12px; padding: 14px 16px; background: rgba(0,0,0,.28); min-height: 6.5em; }
  .hf-cap p { margin: 0; }
  .hf-cap .k { font-size: .74rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #fb923c; }
  .hf-cap .ct { font-weight: 800; font-size: 1.12rem; margin: 4px 0; color: #fff; }
  .hf-cap .cx { color: #c9d7ea; line-height: 1.5; }
  .hf-ctl { display: flex; gap: 8px; margin-top: 14px; }
  .hf-ctl button { font: inherit; font-weight: 800; border-radius: 999px; padding: 9px 16px; cursor: pointer; border: 2px solid #38bdf8; background: transparent; color: #e6eef9; }
  .hf-ctl .hf-play { background: #fb923c; border-color: #fb923c; color: #0a1630; }
  .hf-ctl button:disabled { opacity: .35; cursor: default; }
  @media (max-width: 899px) {
    .hf-grid { grid-template-columns: 1fr; grid-template-areas: "n1" "a1" "n2" "a2" "n3" "a3" "n4" "a4" "n5" "a5" "n6"; }
    .hf-arrow, .hf-arrow.l, .hf-arrow.d { flex-direction: row; justify-content: flex-start; padding: 8px 0 14px 28px; gap: 14px; }
    .hf-arrow .ln, .hf-arrow.d .ln { width: 3px; height: 40px; order: 0; }
    .hf-arrow .lab, .hf-arrow.l .lab, .hf-arrow.d .lab { order: 1; text-align: left; max-width: none; }
    .hf-arrow.l .ln { order: 0; }
    .hf-cap { position: sticky; bottom: 70px; z-index: 2; background: #0b1a36; box-shadow: 0 -8px 24px -8px rgba(0,0,0,.6); min-height: 0; }
    .hf-ctl { position: sticky; bottom: 10px; z-index: 2; }
    .hf-arrow .ln::after, .hf-arrow.r .ln::after, .hf-arrow.l .ln::after { right: auto; top: auto; left: 50%; bottom: -12px; transform: translateX(-50%); border: 8px solid transparent; border-top: 12px solid currentColor; border-bottom: 0; }
    .prose .hf, .hf { padding: 20px 16px 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .hf-node, .hf-node.active { transition: none; animation: none; transform: none; } }
</style>

<script>
  const sec = document.getElementById('hf-optimjack');
  const slot = document.querySelector('[data-diagram="optimjack"]');
  if (sec && slot) {
    slot.replaceWith(sec);
    sec.hidden = false;
    const caps: { title: string; text: string }[] = JSON.parse(sec.querySelector('.hf-data')!.textContent || '[]');
    const nodes = Array.from(sec.querySelectorAll<HTMLButtonElement>('.hf-node'));
    const arrows = Array.from(sec.querySelectorAll<HTMLElement>('.hf-arrow'));
    const k = sec.querySelector<HTMLElement>('.hf-cap .k')!;
    const ct = sec.querySelector<HTMLElement>('.hf-cap .ct')!;
    const cx = sec.querySelector<HTMLElement>('.hf-cap .cx')!;
    const play = sec.querySelector<HTMLButtonElement>('.hf-play')!;
    const [prev, next] = Array.from(sec.querySelectorAll<HTMLButtonElement>('.hf-step'));
    const last = nodes.length;
    let step = 0;
    let timer = 0;
    const show = (n: number) => {
      step = n;
      sec.classList.toggle('on', n > 0);
      nodes.forEach((el, i) => { el.classList.toggle('active', i + 1 === n); el.classList.toggle('done', i + 1 < n); el.setAttribute('aria-pressed', String(i + 1 === n)); });
      arrows.forEach((el, i) => el.classList.toggle('done', i + 2 <= n));
      k.textContent = n ? `Step ${n} of ${last}` : 'How to use this';
      ct.textContent = caps[n].title;
      cx.textContent = caps[n].text;
      prev.disabled = n <= 1;
      next.disabled = n >= last;
    };
    const stop = () => { clearInterval(timer); timer = 0; play.textContent = step >= last ? '↻ Replay the attack' : '▶ Play the attack'; };
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (step === 0 || step >= last) show(1);
      play.textContent = '❚❚ Pause';
      timer = window.setInterval(() => { show(Math.min(step + 1, last)); if (step >= last) stop(); }, 3600);
    });
    prev.addEventListener('click', () => { stop(); show(Math.max(1, step - 1)); });
    next.addEventListener('click', () => { stop(); show(Math.min(last, step + 1)); });
    nodes.forEach((el, i) => el.addEventListener('click', () => { stop(); show(i + 1); }));
  }
</script>
