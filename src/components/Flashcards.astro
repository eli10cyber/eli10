---
interface Props { cards: { q: string; a: string }[] }
const { cards } = Astro.props;
---
{cards.length > 0 && (
  <section class="flash" aria-labelledby="flash-title">
    <h2 id="flash-title">Test yourself</h2>
    <p class="muted">Answer out loud first, then check.</p>
    <div class="flash-grid">
      {cards.map((c, i) => (
        <details class="flash-card">
          <summary><span class="flash-n mono">{i + 1}</span>{c.q}</summary>
          <p>{c.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .flash { margin-top: 3rem; }
  .flash h2 { margin-top: 0; }
  .flash-grid { display: grid; gap: 10px; }
  .flash-card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-l); }
  .flash-card[open] { border-color: var(--ink); }
  .flash-card summary { cursor: pointer; list-style: none; padding: 16px 20px; font-weight: 700; display: flex; gap: 12px; align-items: baseline; }
  .flash-card summary::-webkit-details-marker { display: none; }
  .flash-card summary::after { content: 'Show answer'; margin-left: auto; font-size: 0.8rem; color: var(--ink-2); font-weight: 600; white-space: nowrap; padding-left: 8px; }
  .flash-card[open] summary::after { content: 'Hide'; }
  .flash-card p { margin: 0; padding: 0 20px 18px 54px; font-variation-settings: 'CASL' 1, 'MONO' 0; }
  .flash-n { color: var(--ink-2); flex-shrink: 0; min-width: 22px; }
  @media (max-width: 560px) { .flash-card p { padding-left: 20px; } }
</style>
