---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.number - b.data.number);
const latest = [...lessons].reverse().slice(0, 5);
const news = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const story = news[0];
const first = lessons[0];

// One example per published lesson. The homepage picks one per day; "Show me another" cycles.
const score = (b?: { budget: number; pain: number; pressure: number; owner: number }) => (b ? b.budget + b.pain + b.pressure + b.owner : null);
const examples = lessons
  .filter((l) => l.data.grownLiner)
  .map((l) => ({
    href: `/lessons/${l.id}/`,
    name: l.data.title.split(':')[0],
    kid: l.data.oneLiner,
    grown: l.data.grownLiner!,
    buyer: l.data.buyerScore ? (l.data.buyerScore.pitch ?? l.data.buyerScore.verdict) : '',
    score: score(l.data.buyerScore),
  }));
const ex = examples[0];
const levels = [
  { id: 'kid', label: 'Like you’re 10' },
  { id: 'grown', label: 'Grown-up' },
  { id: 'buyer', label: 'Why a buyer cares' },
] as const;
---
<Base title="ELI10 Cyber" description="Cybersecurity explained three ways: like you're 10, like a grown-up, and why a buyer cares. For people moving into security mid-career.">
  <section class="hero wrap">
    <div class="hero-intro">
      <h1>Every security idea, explained three&nbsp;ways.</h1>
      <p class="lead muted">For people moving into cybersecurity mid-career. Start simple, get precise, then learn why companies pay for it.</p>
    </div>

    <div class="switch" data-level="kid">
      <div class="switch-tabs" role="tablist" aria-label="Explain it">
        {levels.map((l, i) => (
          <button type="button" role="tab" id={`tab-${l.id}`} aria-controls="switch-panel" aria-selected={i === 0 ? 'true' : 'false'} data-level={l.id}>{l.label}</button>
        ))}
      </div>
      <div class="switch-panel" id="switch-panel" role="tabpanel" aria-live="polite" aria-labelledby="tab-kid">
        <div class="switch-meta">
          <p class="switch-topic small muted">Today’s example: <a data-ex="link" href={ex?.href}>{ex?.name}</a></p>
          <button type="button" class="shuffle small" data-ex="next">Show me another <span aria-hidden="true">↻</span></button>
        </div>
        {levels.map((l, i) => (
          <p class="switch-text" data-for={l.id} data-ex={l.id} hidden={i !== 0}>{ex?.[l.id]}</p>
        ))}
        <p class="switch-score small" data-for="buyer" hidden>Buyer score <strong data-ex="score">{ex?.score}</strong>/10 · <a href="/selling-points/">all selling points</a></p>
      </div>
    </div>
    <script type="application/json" id="examples" set:html={JSON.stringify(examples)} />

    <div class="cta">
      {first && <a class="btn btn-primary" href={`/lessons/${first.id}/`}>Start the first lesson</a>}
      <a class="btn" href="/map/">Open the learning map</a>
    </div>
  </section>

  {story && (
    <section class="wrap">
      <a class="story-card" href={`/news/${story.id}/`}>
        <span class="sc-tag small">In the news, explained</span>
        <span class="sc-title">{story.data.title}</span>
        <span class="sc-line muted">{story.data.oneLiner}</span>
        <span class="sc-more small">Read the story →</span>
      </a>
    </section>
  )}

  {latest.length > 0 && (
    <section class="wrap">
      <h2>Latest lessons</h2>
      <ol class="lesson-list" reversed>
        {latest.map((l) => (
          <li>
            <a href={`/lessons/${l.id}/`}>
              <span class="ln mono">{String(l.data.number).padStart(2, '0')}</span>
              <span class="lt">{l.data.title}</span>
              <span class="lo muted">{l.data.oneLiner}</span>
            </a>
          </li>
        ))}
      </ol>
      <p><a href="/lessons/">See all lessons</a></p>
    </section>
  )}

  <section class="wrap story">
    <h2>Why I’m writing this</h2>
    <div class="measure">
      <p>I’ve spent seven years in digital advertising, at Meta, GroupM and Sportradar. Now I’m learning security from scratch, and the fastest way I’ve found to understand a protocol is to explain it to a ten-year-old, then draw it.</p>
      <p>Every lesson here is one of those explanations, checked against official sources, with the commercial view added for anyone coming from sales, marketing or account management.</p>
      <p><a href="/about/">Read more about me</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 8px; padding-bottom: 24px; display: grid; gap: 0 56px; }
  @media (min-width: 1000px) {
    .hero { grid-template-columns: 1fr 1.05fr; align-items: center; }
    .hero-intro { grid-column: 1; grid-row: 1 / span 2; }
    .switch { grid-column: 2; grid-row: 1; }
    .cta { grid-column: 2; grid-row: 2; }
  }
  .hero h1 { max-width: 14ch; font-size: clamp(2.5rem, 8.5vw, 4.6rem); font-weight: 900; }
  .lead { font-size: 1.2rem; margin: 1.1rem 0 2rem; max-width: 46ch; }

  .switch { max-width: 760px; border: 2px solid var(--ink); border-radius: var(--radius-l); background: var(--surface); overflow: hidden; }
  .switch-tabs { display: flex; border-bottom: 2px solid var(--ink); }
  .switch-tabs button {
    flex: 1; font: inherit; font-weight: 700; font-size: 0.95rem; padding: 12px 10px; border: 0; cursor: pointer;
    background: transparent; color: var(--ink-2);
  }
  .switch-tabs button + button { border-left: 2px solid var(--ink); }
  .switch-tabs button[aria-selected='true'] { background: var(--marker); color: var(--marker-ink); }
  .switch-panel { padding: 22px 26px 26px; min-height: 12.5rem; }
  .switch-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 0.6rem; }
  .switch-topic { margin: 0; }
  .shuffle { font: inherit; font-weight: 700; background: transparent; color: inherit; border: 1.5px solid currentColor; border-radius: 999px; padding: 4px 12px; cursor: pointer; white-space: nowrap; opacity: 0.85; }
  .shuffle:hover { opacity: 1; }
  .shuffle span { display: inline-block; transition: transform .4s ease; }
  .shuffle:hover span { transform: rotate(180deg); }
  .switch-score { margin: 1rem 0 0; }
  .switch-score strong { background: var(--marker); color: var(--marker-ink); border-radius: 6px; padding: 1px 7px; }
  .switch-text.swap { animation: swap .35s ease-out; }
  @keyframes swap { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .switch-text.swap, .switch-text { animation: none !important; } }
  .switch-text {
    font-size: clamp(1.25rem, 3.2vw, 1.65rem); line-height: 1.38; font-weight: 600; margin: 0;
  }
  /* The one deliberate motion: handwriting sharpens into precise type as you go up a level */
  .switch-text[data-for='grown']:not([hidden]),
  .switch-text[data-for='buyer']:not([hidden]) { animation: sharpen .6s ease-out; }
  @keyframes sharpen { from { font-variation-settings: 'CASL' 1, 'MONO' 0; } }
  .switch-text[data-for='kid'] { font-variation-settings: 'CASL' 1, 'MONO' 0; }
  .switch-text[data-for='grown'] { font-variation-settings: 'CASL' 0, 'MONO' 0; font-weight: 500; }
  .switch-text[data-for='buyer'] { font-variation-settings: 'CASL' 0, 'MONO' 0; font-weight: 700; }
  .switch[data-level='buyer'] .switch-panel { background: var(--buyer-bg); color: var(--buyer-ink); }
  .switch[data-level='buyer'] .switch-panel .muted { color: var(--buyer-2); }
  .switch[data-level='buyer'] .switch-panel a { color: var(--buyer-link); }

  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 1.75rem; }

  .lesson-list { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); max-width: 860px; }
  .lesson-list li { border-bottom: 1px solid var(--rule); }
  .lesson-list a { display: grid; grid-template-columns: 3rem 1fr; column-gap: 12px; padding: 16px 0; text-decoration: none; color: var(--ink); }
  .lesson-list a:hover .lt { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 4px; text-underline-offset: 0.15em; }
  .ln { color: var(--ink-2); padding-top: 0.2rem; }
  .lt { font-weight: 750; font-size: 1.2rem; line-height: 1.3; }
  .lo { grid-column: 2; margin-top: 4px; }

  .story { margin-top: 1rem; }
  .story-card { display: grid; gap: 8px; max-width: 860px; margin: 1rem 0 0.5rem; padding: 20px 22px; border: 2px solid var(--ink); border-radius: var(--radius-l); background: var(--surface); text-decoration: none; color: var(--ink); box-shadow: 6px 6px 0 var(--marker); transition: transform .15s, box-shadow .15s; }
  .story-card:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--marker); }
  .sc-tag { justify-self: start; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; font-size: .72rem; background: var(--marker); color: var(--marker-ink); padding: 3px 10px; border-radius: 999px; }
  .sc-title { font-weight: 800; font-size: clamp(1.3rem, 3.5vw, 1.7rem); line-height: 1.25; }
  .sc-more { font-weight: 750; color: var(--link); }
  @media (prefers-reduced-motion: reduce) { .story-card { transition: none; } .story-card:hover { transform: none; } }

  @media (max-width: 560px) {
    .switch-tabs button { font-size: 0.82rem; padding: 10px 6px; line-height: 1.2; }
    .switch-panel { padding: 18px; min-height: 15rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.switch').forEach((sw) => {
    const tabs = Array.from(sw.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panel = sw.querySelector('[role="tabpanel"]')!;
    const select = (id: string, focus = false) => {
      sw.dataset.level = id;
      tabs.forEach((t) => {
        const on = t.dataset.level === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      sw.querySelectorAll<HTMLElement>('[data-for]').forEach((p) => (p.hidden = p.dataset.for !== id));
      panel.setAttribute('aria-labelledby', `tab-${id}`);
    };
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => select(t.dataset.level!));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(tabs[(i + dir + tabs.length) % tabs.length].dataset.level!, true);
      });
    });

    // Rotating example: one per day, and a button to cycle through the rest
    type Ex = { href: string; name: string; kid: string; grown: string; buyer: string; score: number | null };
    let list: Ex[] = [];
    try { list = JSON.parse(document.getElementById('examples')?.textContent || '[]'); } catch {}
    if (!list.length) return;
    const get = (k: string) => sw.querySelector<HTMLElement>(`[data-ex="${k}"]`)!;
    const day = Math.floor(Date.now() / 86400000);
    let idx = day % list.length;
    const show = (animate: boolean) => {
      const e = list[idx];
      const link = get('link') as HTMLAnchorElement;
      link.href = e.href; link.textContent = e.name;
      (['kid', 'grown', 'buyer'] as const).forEach((k) => {
        const p = get(k); p.textContent = e[k];
        if (animate) { p.classList.remove('swap'); void p.offsetWidth; p.classList.add('swap'); }
      });
      const sc = get('score');
      sc.textContent = e.score == null ? '–' : String(e.score);
    };
    show(false);
    get('next').addEventListener('click', () => { idx = (idx + 1) % list.length; show(true); });
  });
</script>
