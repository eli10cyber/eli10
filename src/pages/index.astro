---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.number - b.data.number);
const latest = [...lessons].reverse().slice(0, 5);
const first = lessons[0];

const levels = [
  {
    id: 'kid',
    label: 'Like you’re 10',
    text: 'DNSSEC is a wax seal on the internet’s address book. If someone swaps the page, the seal breaks and your computer refuses to go there.',
  },
  {
    id: 'grown',
    label: 'Grown-up',
    text: 'DNSSEC signs DNS records with RRSIG, DNSKEY and DS records, so a validating resolver can prove an answer is authentic and unaltered. It does not encrypt anything.',
  },
  {
    id: 'buyer',
    label: 'Why a buyer cares',
    text: 'It stops customers being silently sent to a fake login page. Companies rarely buy it alone: it comes inside managed DNS and DDI platforms run by the network team.',
  },
];
---
<Base title="ELI10 Cyber" description="Cybersecurity explained three ways: like you're 10, like a grown-up, and why a buyer cares. For people moving into security mid-career.">
  <section class="hero wrap">
    <div class="hero-intro">
      <h1>Every security idea, explained three&nbsp;ways.</h1>
      <p class="lead muted">For people moving into cybersecurity mid-career. Start simple, get precise, then learn why companies pay for it.</p>
    </div>

    <div class="switch" data-level="kid">
      <div class="switch-tabs" role="tablist" aria-label="Explain it">
        {levels.map((l, i) => (
          <button type="button" role="tab" id={`tab-${l.id}`} aria-controls="switch-panel" aria-selected={i === 0 ? 'true' : 'false'} data-level={l.id}>{l.label}</button>
        ))}
      </div>
      <div class="switch-panel" id="switch-panel" role="tabpanel" aria-live="polite" aria-labelledby="tab-kid">
        <p class="switch-topic small muted">Today’s example: <a href={first ? `/lessons/${first.id}/` : '/lessons/'}>DNSSEC</a></p>
        {levels.map((l, i) => (
          <p class="switch-text" data-for={l.id} hidden={i !== 0}>{l.text}</p>
        ))}
      </div>
    </div>

    <div class="cta">
      {first && <a class="btn btn-primary" href={`/lessons/${first.id}/`}>Read lesson 1</a>}
      <a class="btn" href="/map/">Open the learning map</a>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="wrap">
      <h2>Latest lessons</h2>
      <ol class="lesson-list" reversed>
        {latest.map((l) => (
          <li>
            <a href={`/lessons/${l.id}/`}>
              <span class="ln mono">{String(l.data.number).padStart(2, '0')}</span>
              <span class="lt">{l.data.title}</span>
              <span class="lo muted">{l.data.oneLiner}</span>
            </a>
          </li>
        ))}
      </ol>
      <p><a href="/lessons/">See all lessons</a></p>
    </section>
  )}

  <section class="wrap story">
    <h2>Why I’m writing this</h2>
    <div class="measure">
      <p>I’ve spent seven years in digital advertising, at Meta, GroupM and Sportradar. Now I’m learning security from scratch, and the fastest way I’ve found to understand a protocol is to explain it to a ten-year-old, then draw it.</p>
      <p>Every lesson here is one of those explanations, checked against official sources, with the commercial view added for anyone coming from sales, marketing or account management.</p>
      <p><a href="/about/">Read more about me</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 8px; padding-bottom: 24px; display: grid; gap: 0 56px; }
  @media (min-width: 1000px) {
    .hero { grid-template-columns: 1fr 1.05fr; align-items: center; }
    .hero-intro { grid-column: 1; grid-row: 1 / span 2; }
    .switch { grid-column: 2; grid-row: 1; }
    .cta { grid-column: 2; grid-row: 2; }
  }
  .hero h1 { max-width: 14ch; font-size: clamp(2.5rem, 8.5vw, 4.6rem); font-weight: 900; }
  .lead { font-size: 1.2rem; margin: 1.1rem 0 2rem; max-width: 46ch; }

  .switch { max-width: 760px; border: 2px solid var(--ink); border-radius: var(--radius-l); background: var(--surface); overflow: hidden; }
  .switch-tabs { display: flex; border-bottom: 2px solid var(--ink); }
  .switch-tabs button {
    flex: 1; font: inherit; font-weight: 700; font-size: 0.95rem; padding: 12px 10px; border: 0; cursor: pointer;
    background: transparent; color: var(--ink-2);
  }
  .switch-tabs button + button { border-left: 2px solid var(--ink); }
  .switch-tabs button[aria-selected='true'] { background: var(--marker); color: var(--marker-ink); }
  .switch-panel { padding: 22px 26px 26px; min-height: 12.5rem; }
  .switch-topic { margin-bottom: 0.6rem; }
  .switch-text {
    font-size: clamp(1.25rem, 3.2vw, 1.65rem); line-height: 1.38; font-weight: 600; margin: 0;
  }
  /* The one deliberate motion: handwriting sharpens into precise type as you go up a level */
  .switch-text[data-for='grown']:not([hidden]),
  .switch-text[data-for='buyer']:not([hidden]) { animation: sharpen .6s ease-out; }
  @keyframes sharpen { from { font-variation-settings: 'CASL' 1, 'MONO' 0; } }
  .switch-text[data-for='kid'] { font-variation-settings: 'CASL' 1, 'MONO' 0; }
  .switch-text[data-for='grown'] { font-variation-settings: 'CASL' 0, 'MONO' 0; font-weight: 500; }
  .switch-text[data-for='buyer'] { font-variation-settings: 'CASL' 0, 'MONO' 0; font-weight: 700; }
  .switch[data-level='buyer'] .switch-panel { background: var(--buyer-bg); color: var(--buyer-ink); }
  .switch[data-level='buyer'] .switch-panel .muted { color: var(--buyer-2); }
  .switch[data-level='buyer'] .switch-panel a { color: var(--marker); }

  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 1.75rem; }

  .lesson-list { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); max-width: 860px; }
  .lesson-list li { border-bottom: 1px solid var(--rule); }
  .lesson-list a { display: grid; grid-template-columns: 3rem 1fr; column-gap: 12px; padding: 16px 0; text-decoration: none; color: var(--ink); }
  .lesson-list a:hover .lt { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 4px; text-underline-offset: 0.15em; }
  .ln { color: var(--ink-2); padding-top: 0.2rem; }
  .lt { font-weight: 750; font-size: 1.2rem; line-height: 1.3; }
  .lo { grid-column: 2; margin-top: 4px; }

  .story { margin-top: 1rem; }

  @media (max-width: 560px) {
    .switch-tabs button { font-size: 0.82rem; padding: 10px 6px; line-height: 1.2; }
    .switch-panel { padding: 18px; min-height: 15rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.switch').forEach((sw) => {
    const tabs = Array.from(sw.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const texts = Array.from(sw.querySelectorAll<HTMLElement>('.switch-text'));
    const panel = sw.querySelector('[role="tabpanel"]')!;
    const select = (id: string, focus = false) => {
      sw.dataset.level = id;
      tabs.forEach((t) => {
        const on = t.dataset.level === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      texts.forEach((p) => (p.hidden = p.dataset.for !== id));
      panel.setAttribute('aria-labelledby', `tab-${id}`);
    };
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => select(t.dataset.level!));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(tabs[(i + dir + tabs.length) % tabs.length].dataset.level!, true);
      });
    });
  });
</script>
