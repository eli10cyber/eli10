---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Flashcards from '../../components/Flashcards.astro';
import LearnedButton from '../../components/LearnedButton.astro';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.number - b.data.number);
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1] },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const d = lesson.data;
const date = d.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title} description={d.description} image={d.image} type="article">
  <article class="narrow">
    <p class="crumbs small"><a href="/lessons/">Lessons</a> · Lesson #{String(d.number).padStart(2, '0')}{d.chapter && ` · ${d.chapter}`}</p>
    <h1>{d.title}</h1>
    <p class="muted small">{date} · Vas Evangelopoulos</p>

    <div class="box box-kid oneliner">
      <div class="box-label">🖍️ In one sentence</div>
      <p>{d.oneLiner}</p>
    </div>

    {d.image && <img class="hero" src={d.image} alt={d.imageAlt ?? ''} width="1200" height="675" />}

    <div class="prose">
      <Content />
    </div>

    <Flashcards cards={d.flashcards} />
    <LearnedButton topic={d.topic} />

    <nav class="pager" aria-label="More lessons">
      {prev ? <a class="card card-link" href={`/lessons/${prev.id}/`}><span class="small muted">← Previous</span><br />{prev.data.title}</a> : <span />}
      {next ? <a class="card card-link right" href={`/lessons/${next.id}/`}><span class="small muted">Next lesson →</span><br />{next.data.title}</a> : <a class="card card-link right" href="/map/"><span class="small muted">What’s next →</span><br />See the learning map</a>}
    </nav>
  </article>
</Base>

<style>
  .crumbs { margin: 0 0 0.75rem; }
  .crumbs a { color: var(--ink-2); }
  .oneliner p { font-size: 1.2rem; font-family: var(--font-head); font-weight: 700; }
  .hero { border-radius: var(--radius); border: 1px solid var(--line); margin: 0.5rem 0 1.5rem; display: block; width: 100%; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 3rem; }
  .pager .right { text-align: right; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .right { text-align: left; } }
</style>
