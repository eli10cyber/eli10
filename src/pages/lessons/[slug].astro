---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Flashcards from '../../components/Flashcards.astro';
import LearnedButton from '../../components/LearnedButton.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.number - b.data.number);
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1] },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const d = lesson.data;
const date = d.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title} description={d.description} image={d.image} type="article">
  <article class="wrap">
    <header class="lesson-head measure">
      <p class="crumbs small muted"><a href="/lessons/">Lessons</a> / Lesson {d.number}{d.chapter && <span>, {d.chapter}</span>}</p>
      <h1>{d.title}</h1>
      <p class="byline small muted">Vas Evangelopoulos, {date}</p>
      <p class="oneliner casual">{d.oneLiner}</p>
    </header>

    {d.image && <img class="hero" src={d.image} alt={d.imageAlt ?? ''} width="1200" height="675" />}

    <div class="prose measure">
      <Content />
    </div>

    <div class="measure">
      <Flashcards cards={d.flashcards} />
      <LearnedButton topic={d.topic} />

      <nav class="pager" aria-label="More lessons">
        {prev ? <a href={`/lessons/${prev.id}/`}><span class="small muted">Previous lesson</span><span class="pt">{prev.data.title}</span></a> : <span />}
        {next ? <a class="right" href={`/lessons/${next.id}/`}><span class="small muted">Next lesson</span><span class="pt">{next.data.title}</span></a> : <a class="right" href="/map/"><span class="small muted">What to learn next</span><span class="pt">Open the learning map</span></a>}
      </nav>
    </div>
  </article>
  <Lightbox />
</Base>

<style>
  .crumbs { margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-2); }
  .lesson-head h1 { font-size: clamp(2rem, 6vw, 3rem); }
  .byline { margin: 0.9rem 0 1.5rem; }
  .oneliner { font-size: clamp(1.25rem, 3vw, 1.5rem); line-height: 1.4; font-weight: 650; padding-left: 18px; border-left: 6px solid var(--marker); margin: 0 0 2rem; }
  .hero { border-radius: var(--radius-l); border: 1px solid var(--rule); margin: 0 0 2rem; display: block; width: 100%; max-width: 900px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 3.5rem; border-top: 2px solid var(--ink); padding-top: 16px; }
  .pager a { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 4px; }
  .pager .pt { font-weight: 750; }
  .pager a:hover .pt { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 4px; }
  .pager .right { text-align: right; align-items: flex-end; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .right { text-align: left; align-items: flex-start; } }
</style>
