---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => b.data.number - a.data.number);
---
<Base title="Lessons" description="Every ELI10 Cyber lesson: one security idea at a time, explained simply, then properly.">
  <div class="wrap">
    <h1>All <span class="scribble">lessons</span></h1>
    <p class="muted lead">One idea per lesson. A simple version first, then the grown-up version, then why companies actually pay for it.</p>
    <div class="grid">
      {lessons.map((l) => (
        <a class="card card-link" href={`/lessons/${l.id}/`}>
          <span class="tag">#{String(l.data.number).padStart(2, '0')}</span>
          <h2 class="lesson-title">{l.data.title}</h2>
          <p class="muted">{l.data.oneLiner}</p>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .lead { max-width: 620px; margin-bottom: 2rem; }
  .lesson-title { font-size: 1.25rem; margin: 0.6rem 0 0.4rem; }
  .card p { margin: 0; }
</style>
