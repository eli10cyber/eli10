---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LessonCard from '../../components/LessonCard.astro';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.number - b.data.number);
---
<Base title="Lessons" description="Every ELI10 Cyber lesson: one security idea at a time, explained simply, then properly, then commercially.">
  <div class="wrap">
    <h1>Lessons</h1>
    <p class="lead muted measure">One idea per lesson, in the order I’m learning them, from number 01 up. Each starts simple, gets precise, and ends with why companies pay for it.</p>
    <div class="progress" hidden>
      <p class="small"><strong class="p-done">0</strong> of {lessons.length} lessons learned on this device</p>
      <div class="p-bar" aria-hidden="true"><span></span></div>
    </div>
    <ol class="lcards">
      {lessons.map((l, i) => <li><LessonCard lesson={l} eager={i < 3} /></li>)}
    </ol>
  </div>
</Base>

<style>
  .lead { font-size: 1.15rem; margin: 1rem 0 2rem; }
  .progress { max-width: 860px; margin: 0 0 1.5rem; }
  .progress p { margin: 0 0 6px; }
  .p-bar { height: 10px; border-radius: 999px; background: var(--paper-2); overflow: hidden; border: 1px solid var(--rule); }
  .p-bar span { display: block; height: 100%; width: 0; background: var(--marker); transition: width .6s ease; }
</style>

<script>
  import { markLearned } from '../../scripts/learned-ticks';
  const done = markLearned();
  const total = document.querySelectorAll('.lcard').length;
  if (done > 0) {
    const box = document.querySelector<HTMLElement>('.progress')!;
    box.hidden = false;
    box.querySelector('.p-done')!.textContent = String(done);
    requestAnimationFrame(() => { box.querySelector<HTMLElement>('.p-bar span')!.style.width = `${(done / total) * 100}%`; });
  }
</script>
