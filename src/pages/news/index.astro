---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="In the news" description="Real security headlines explained three ways: like you're 10, properly, and why a buyer cares.">
  <div class="wrap">
    <h1>In the news, explained</h1>
    <p class="lead muted measure">Real security headlines, explained the eli10 way, with the lessons behind them and what they mean for the companies that buy security.</p>
    <ol class="news-list">
      {posts.map((p) => (
        <li>
          <a href={`/news/${p.id}/`}>
            <span class="nd mono small">{fmt(p.data.pubDate)}</span>
            <span class="nt">{p.data.title}</span>
            <span class="no muted">{p.data.oneLiner}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .lead { font-size: 1.15rem; margin: 1rem 0 2rem; }
  .news-list { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); max-width: 860px; }
  .news-list li { border-bottom: 1px solid var(--rule); }
  .news-list a { display: grid; gap: 4px; padding: 18px 0; text-decoration: none; color: var(--ink); }
  .nd { color: var(--ink-2); }
  .nt { font-weight: 750; font-size: 1.25rem; line-height: 1.3; }
  .news-list a:hover .nt { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 4px; text-underline-offset: 0.15em; }
</style>
