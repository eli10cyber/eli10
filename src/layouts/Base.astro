---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image = '/images/og-default.png', type = 'website' } = Astro.props;
const fullTitle = title === 'ELI10 Cyber' ? title : `${title} · ELI10 Cyber`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/lessons/', label: 'Lessons' },
  { href: '/map/', label: 'Map' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/recursive.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="ELI10 Cyber" href="/rss.xml" />
    <meta name="theme-color" content="#f2f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1b30" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="wordmark" aria-label="ELI10 Cyber home"><span class="w-kid">eli10</span><span class="w-tech">cyber</span></a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="muted">Cybersecurity explained three ways, for people switching careers mid-way. Written by Vas Evangelopoulos, a commercial leader learning in public.</p>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/vevangelopoulos" rel="me noopener" target="_blank">Follow on LinkedIn</a>
          <a href="/rss.xml">RSS feed</a>
          <a href="mailto:hello@eli10cyber.com">hello@eli10cyber.com</a>
        </div>
      </div>
      <p class="wrap small muted">Independent study notes, not affiliated with or endorsed by CompTIA. Security+ is a trademark of CompTIA.</p>
    </footer>
  </body>
</html>
